model PricingRule {
  id         String      @id @default(uuid())
  hotelId    String
  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  roomTypeId String
  roomType   Room        @relation(fields: [roomTypeId], references: [id])
  type       PricingType
  startDate  DateTime
  endDate    DateTime
  modifier   Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([hotelId])
  @@index([roomTypeId])
  @@map("pricing_rules")
}

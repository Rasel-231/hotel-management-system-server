model BookingCheckLog {
  id         String     @id @default(uuid())
  bookingId  String
  booking    Booking    @relation(fields: [bookingId], references: [id])
  checkInAt  DateTime?
  checkOutAt DateTime?
  handledBy  String?
  staff      HotelStaff? @relation(fields: [handledBy], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([bookingId])
  @@index([handledBy])
  @@map("booking_check_logs")
}

model Booking {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  checkIn       DateTime
  checkOut      DateTime
  status        BookingStatus @default(PENDING)
  source        String?       @default("ONLINE")
  guests        Int?
  adults        Int           @default(1)
  children      Int           @default(0)
  roomsCount    Int           @default(1)
  bookedFor     BookedFor     @default(SELF) // 🔧 String → enum
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  guestIdType   IdType? // 🔧 optional: also enum-ify since IdType enum exists
  guestIdNumber String?
  guestAddress  String?
  guestPurpose  VisitPurpose? // 🔧 optional: VisitPurpose enum exists too

  specialRequests String?

  noShow      Boolean   @default(false)
  cancelledAt DateTime?
  expiresAt   DateTime?
  totalPrice  Float

  payment          Payment?
  review           Review?
  bookingCheckLogs BookingCheckLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([roomId])
  @@index([hotelId])
  @@index([userId, status])
  @@index([status])
  @@index([status, expiresAt])
  @@index([checkIn])
  @@index([checkOut])
  @@map("bookings")
}
